# ── Deployment tier ───────────────────────────────────────────────────────────
# internal (default) — the full platform: clinical AI, quality and defect
#                      analysis, the imported knowledge base, admin dashboards.
#                      Run this only on infrastructure the clinic controls.
# public             — the tier that may be published on the open internet and
#                      installed on a phone. Only the patient module, the
#                      deterministic calculators, the academy and the knowledge
#                      library (metadata and citations) are reachable; every
#                      other page and API answers 404, and the knowledge base is
#                      refused even if a database file is present.
APP_TIER=internal

# ── AI provider ────────────────────────────────────────────────────────────────
# Requests go through the OpenAI Responses API using the official SDK.
# The application runs fully without a key (deterministic / demo mode).
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
OPENAI_API_KEY=
AI_TIMEOUT_MS=90000

# One model id drives every user-facing answer.
OPENAI_MODEL=gpt-6-luna
# Reasoning effort for ordinary answers. minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
# Optional, for deep modes only; defaults to OPENAI_REASONING_EFFORT.
# OPENAI_REASONING_EFFORT_DEEP=medium
# Output caps — the main lever on cost.
OPENAI_MAX_OUTPUT_TOKENS=1600
OPENAI_MAX_OUTPUT_TOKENS_DEEP=3000
# Both tiers default to OPENAI_MODEL. Set these only to split the two
# deliberately; a costlier model is never selected on its own.
# AI_MODEL_FAST=
# AI_MODEL_REASONING=

# ── Embeddings (semantic half of hybrid retrieval) ─────────────────────────────
# auto   — OpenAI-compatible embeddings when a key exists, otherwise the offline
#          hash provider. hash | openai force one explicitly.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Changing the provider requires re-running `npm run kb:import` so that the
# vector index is rebuilt in the new vector space.

# ── Knowledge base ─────────────────────────────────────────────────────────────
# Folder holding GMAI_Clinical_Rules_Master_v1.json and
# GMAI_Quality_Defect_Rules_Master_v1.json. Never committed to the repository.
KB_SOURCE_DIR=./knowledge-source
KB_DB_PATH=./data/gmai-kb.sqlite

# ── Metering ───────────────────────────────────────────────────────────────────
# Override the model price list used by the cost calculator. USD per million tokens.
# MODEL_PRICING_JSON=[{"model":"gpt-6-luna","inputPerMTok":0.1,"cachedInputPerMTok":0.01,"outputPerMTok":0.5}]
# Set to 1 to store the retrieval query text in the audit log (off by default so
# that no case text is written to logs).
LOG_RETRIEVAL_QUERY=0

# ── Internal tooling ───────────────────────────────────────────────────────────
# 1 exposes /admin/knowledge, /admin/retrieval, /admin/usage and /dev/ingest.
# MUST be 0 in production.
ENABLE_DEV_TOOLS=0

# ── Optional PostgreSQL (source registry mirror; the app runs without it) ──────
DATABASE_URL=
