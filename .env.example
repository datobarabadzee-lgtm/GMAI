# GMAI — გარემოს ცვლადები. გენერირებულია src/config/env-schema.json-დან.
# შემოწმება (მნიშვნელობებს არ ბეჭდავს): npm run env:check -- --hosting self_hosted --env-file .env.production
# საიდუმლო ცვლადები (secret) მიუთითეთ ჰოსტის secret store-ში; ამ ფაილში ცარიელია.

# ── განთავსება ──
# განთავსების დონე. აუცილებლად მიუთითეთ ცხადად. დაუყენებელი ან უცნობი მნიშვნელობა = public (უსაფრთხო ნაგულისხმევი). internal მხოლოდ კლინიკის კონტროლირებად ინფრასტრუქტურაზე. [required: always]
APP_TIER=public

# ── უსაფრთხოება ──
# საჯარო მისამართი (მაგ. https://gmai.example.ge). ოპერატორის mutation-ების Origin/CSRF შემოწმება ამას ადარებს. reverse proxy-ის უკან აუცილებელია. [required: self_hosted]
PUBLIC_ORIGIN=

# ოპერატორის ავთენტიფიკაცია ადმინისტრაციულ ჩაწერებზე (კურაცია, წყაროების რეესტრი). ≥32 სიმბოლო. გარეშე ყველა ადმინისტრაციული ჩაწერა დახურულია. [required: internal_admin, secret]
OPERATOR_TOKEN=

# 1 = /admin და /dev ხელსაწყოები (მხოლოდ internal-ში). production-ში 0. [required: optional]
ENABLE_DEV_TOOLS=0

# ── AI პროვაიდერი ──
# პლატფორმის AI გასაღები, მხოლოდ სერვერზე. გარეშე AI პასუხები მუშაობს მხოლოდ მომხმარებლის საკუთარი გასაღებით (BYOK); დეტერმინისტული მოდულები მუშაობს ყოველთვის. [required: platform_ai, secret]
OPENAI_API_KEY=

# OPENAI_API_KEY-ის ალტერნატიული სახელი (თავსებადი gateway). [required: optional, secret]
AI_API_KEY=

# ამჟამად რეალური adapter მხოლოდ OpenAI Responses API-ა. [required: optional]
AI_PROVIDER=openai

# OpenAI-თავსებადი endpoint. [required: optional]
AI_BASE_URL=https://api.openai.com/v1

# მოდელი. უფრო ძვირი მოდელი ავტომატურად არ ირჩევა. [required: optional]
# OPENAI_MODEL=

# სწრაფი დონის მოდელი (ცალკე მხოლოდ შეგნებულად). [required: optional]
# AI_MODEL_FAST=

# ღრმა რეჟიმის მოდელი. [required: optional]
# AI_MODEL_REASONING=

# ხელახალი ცდის მოდელი. [required: optional]
# AI_MODEL_FALLBACK=

# minimal | low | medium | high [required: optional]
OPENAI_REASONING_EFFORT=low

# ღრმა რეჟიმისთვის. [required: optional]
# OPENAI_REASONING_EFFORT_DEEP=

# პასუხის ზომის ზღვარი (ხარჯის მთავარი ბერკეტი). [required: optional]
OPENAI_MAX_OUTPUT_TOKENS=1600

# ღრმა რეჟიმისთვის. [required: optional]
OPENAI_MAX_OUTPUT_TOKENS_DEEP=3000

# AI მოთხოვნის ვადა. [required: optional]
AI_TIMEOUT_MS=90000

# ერთი აგენტის ვადა; გადაცილება აღირიცხება timeout-ად. [required: optional]
AGENT_TIMEOUT_MS=25000

# ფასების სიის გადაფარვა (USD / 1M token). [required: optional]
# MODEL_PRICING_JSON=

# ── მედიკამენტები ──
# openFDA გასაღები (მაღალი ლიმიტი). მხოლოდ სერვერზე. [required: optional, secret]
OPENFDA_API_KEY=

# პრეპარატის დადასტურების ქვითრის ხელმოწერა. პლატფორმის AI გასაღების გარეშე ჰოსტზე აუცილებელია, თორემ დადასტურება ვერ ხელმოიწერება. [required: byok_only_host, secret]
MED_RECEIPT_SECRET=

# კურირებული რუკის ფაილი (ტესტებისთვის). [required: optional]
MED_CURATED_MAP=knowledge/medications/curated-map.json

# 1 = openFDA/EMA/Europe PMC ცოცხალი მოთხოვნები გამორთულია (ტესტები, offline). [required: optional]
DISABLE_LIVE_SOURCES=0

# ── ლიმიტები და ხარჯი ──
# ლიმიტებისა და ხარჯის მრიცხველი. memory = მხოლოდ ერთი პროცესი; file = ერთი ჰოსტი/volume; redis = რამდენიმე ჰოსტი. [required: multi_instance]
LIMIT_STORE=memory

# file store-ის ფაილი (მუდმივ volume-ზე). [required: optional]
LIMIT_STORE_PATH=data/runtime/limits.json

# redis://[:password@]host:port[/db] ან Upstash-თავსებადი https://… [required: when_redis, secret]
LIMIT_STORE_URL=

# REST Redis-ის token. [required: optional, secret]
LIMIT_STORE_TOKEN=

# აპლიკაციის დღიური ხარჯის ზღვარი (პროვაიდერის ანგარიშის ბიუჯეტი რჩება ერთადერთ გარე მყარ ზღვრად). [required: optional]
DAILY_BUDGET_USD=5

# გაშვების წინასწარი რეზერვაცია ზღვარზე. [required: optional]
AI_RESERVE_USD_PER_RUN=0.03

# [required: optional]
RATE_LIMIT_IP_PER_WINDOW=12

# [required: optional]
RATE_LIMIT_WINDOW_SEC=60

# [required: optional]
RATE_LIMIT_IP_PER_DAY=200

# [required: optional]
RATE_LIMIT_GLOBAL_PER_MIN=120

# ── მონაცემთა დამუშავება ──
# institutional = დაწესებულების დოკუმენტირებული სამართლებრივი საფუძველი. [required: optional]
# PROCESSING_POLICY=

# ამ საფუძვლის დოკუმენტის იდენტიფიკატორი. [required: optional]
# PROCESSING_BASIS_REF=

# ატვირთვის ჯამური ზღვარი. Vercel-ზე ≤4 (პლატფორმის ლიმიტი 4.5 MB); self-hosted-ზე მხოლოდ თუ proxy-ც იღებს. [required: optional]
NEXT_PUBLIC_UPLOAD_MAX_TOTAL_MB=4

# საკონტაქტო ნომერი UI-ში (საჯარო). [required: optional]
# NEXT_PUBLIC_CONTACT_WHATSAPP=

# 1 = ძიების ტექსტი ჟურნალში (ნაგულისხმევად გამორთულია). [required: optional]
LOG_RETRIEVAL_QUERY=0

# ── ცოდნის ბაზა ──
# შიდა SQLite ცოდნის ბაზა (მხოლოდ internal). [required: internal_kb]
KB_DB_PATH=data/gmai-kb.sqlite

# master JSON-ების საქაღალდე იმპორტისთვის. [required: internal_kb]
KB_SOURCE_DIR=knowledge-source

# შიდა ძრავის ვექტორები. hash = ლექსიკური n-gram, არა ნასწავლი სემანტიკა. [required: optional]
EMBEDDING_PROVIDER=auto

# [required: optional]
EMBEDDING_MODEL=text-embedding-3-small

# [required: optional]
EMBEDDING_DIM=1536

# [required: optional]
# EMBEDDING_BASE_URL=

# [required: optional, secret]
EMBEDDING_API_KEY=

# clinical-v2 პაკეტის გზა იმპორტის სკრიპტისთვის. [required: optional]
# CLINICAL_V2_PKG=

# არასავალდებულო PostgreSQL (წყაროების რეესტრის ასლი). [required: optional, secret]
DATABASE_URL=

# ── ოპერაციები ──
# /api/eval/drift-ის token; გარეშე endpoint არ არსებობს. [required: optional, secret]
EVAL_TOKEN=

# release manifest-ის commit, როცა .git არ არის ხელმისაწვდომი. [required: optional]
# RELEASE_COMMIT=

# ── ადამიანური განხილვა (internal) ──
# რეცენზენტები: სახელი|reviewer ან lead|sha256(token); გამყოფი ;  [required: optional, secret]
REVIEWERS=

# განხილვის ჩანაწერების SQLite (მუდმივ volume-ზე). [required: optional]
# REVIEW_DB_PATH=data/review/reviews.sqlite
