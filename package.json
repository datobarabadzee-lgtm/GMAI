{
  "name": "gmai-aih",
  "version": "1.0.0",
  "private": true,
  "description": "Georgian Expert Medical AI + AI Hospital — Georgian-language multi-agent clinical intelligence platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/db/seed.ts",
    "kb:import": "tsx scripts/kb-import.ts",
    "kb:stats": "tsx scripts/kb-stats.ts",
    "kb:inventory": "tsx --conditions=react-server scripts/corpus-inventory.ts",
    "dev:public": "APP_TIER=public next dev",
    "build:public": "APP_TIER=public next build && node scripts/verify-build.mjs",
    "start:public": "APP_TIER=public next start",
    "verify:build": "node scripts/verify-build.mjs",
    "eval:prod": "node scripts/eval-production.mjs",
    "env:check": "tsx scripts/check-env.ts",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:verify": "node scripts/release-manifest.mjs --verify",
    "prebuild": "node scripts/release-manifest.mjs",
    "eval:retrieval": "tsx --conditions=react-server scripts/eval-retrieval.ts",
    "med:coverage": "node scripts/medication-coverage.mjs",
    "med:curation-diff": "node scripts/curation-diff.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "2.1.1",
    "docx": "^9.11.0",
    "drizzle-orm": "0.44.4",
    "lucide-react": "0.544.0",
    "mammoth": "1.9.1",
    "next": "^16.3.5",
    "openai": "^7.34.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "2.6.0",
    "unpdf": "^1.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "^1.64.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.9 <11"
  }
}
