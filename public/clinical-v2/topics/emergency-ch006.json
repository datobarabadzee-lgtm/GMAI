_context","text":"მანევრების ჩატარებისას პაციენტები უნდა იმყოფებოდნენ მუდმივი მეთვალყურეობის ქვეშ.","media":[]},{"id":"emergency-b01178","kind":"statement","clinical_type":"clinical_context","text":"მანევრების ჩატარება არ არის რეკომენდებული პაციენტებზე, რომელთაც აქვთ კაროტიდული არტერიების სტენოზი ან აღნიშნული პათოლოგიის მაღალი რისკი და მწეველებში.","media":[]}]}]},{"id":"emergency-ch006-s011","title":"მედიკამენტოზური თერაპია","units":[{"id":"emergency-ch006-u010","title":"მედიკამენტოზური თერაპია","order":10,"clinical_types":["clinical_context"],"items":[{"id":"emergency-b01180","kind":"heading","clinical_type":"management","text":"მედიკამენტოზური თერაპია:","media":[]},{"id":"emergency-b01182","kind":"statement","clinical_type":"clinical_context","text":"ადენოზინი","media":[]}]}]},{"id":"emergency-ch006-s012","title":"თუ პაროქსიზმული SVT არ რეაგირებს ვაგუსურ მანევრზე","units":[{"id":"emergency-ch006-u011","title":"თუ პაროქსიზმული SVT არ რეაგირებს ვაგუსურ მანევრზე","order":11,"clinical_types":["dosing","clinical_context","safety","management"],"items":[{"id":"emergency-b01183","kind":"heading","clinical_type":"clinical_context","text":"თუ პაროქსიზმული SVT არ რეაგირებს ვაგუსურ მანევრზე:","media":[]},{"id":"emergency-b01184","kind":"statement","clinical_type":"dosing","text":"ადენოზინი 6 mg IV სწრაფი ბოლუსი","media":[]},{"id":"emergency-b01185","kind":"statement","clinical_type":"dosing","text":"შემდგომი 20 მლ ფიზიოლოგიური ხსნარი სწრაფი ბოლუსი.","media":[]},{"id":"emergency-b01186","kind":"statement","clinical_type":"clinical_context","text":"თუ სინუსური რითმი არ აღდგა 1-2 წთ","media":[]},{"id":"emergency-b01187","kind":"statement","clinical_type":"dosing","text":"ადენოზინის განმეორებითი დოზა 12 mg IV","media":[]},{"id":"emergency-b01188","kind":"statement","clinical_type":"dosing","text":"სწრაფად 20 მლ ფიზიოლოგიური ხსნარის მიყოლებით.","media":[]},{"id":"emergency-b01189","kind":"statement","clinical_type":"clinical_context","text":"ადენოზინი აფერხებს ანტეროგრადულ და რე